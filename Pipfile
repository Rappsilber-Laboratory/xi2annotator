[[source]]
url = "https://pypi.org/simple"
verify_ssl = true
name = "pypi"

[packages]
xicommon = ">=1.0.0,<2.0.0"
flask = {extras = ["async"], version = ">=3.1.3,<3.2"}
flask-cors = "*"
waitress = "*"
python-dotenv = ">=1.2.2"
# security floors for transitive dependencies (remove once parents require them)
werkzeug = ">=3.1.9"  # GHSA-g6x2-hccm-hh4m et al., via flask
lxml = ">=6.1.0"  # GHSA-vfmq-68hx-4jfw, via xicommon
pygments = ">=2.20.0"  # GHSA-5239-wwwm-4pmq, via xicommon/pytest

[dev-packages]
recursive-diff = "*"
pytest = ">=9.0.3,<9.1"  # <9.1: pytest-flake8 1.3.0 (latest) breaks on pytest 9.1+ hookspec
pytest-flask = "==1.3.0"
pytest-cov = "*"
pytest-flake8 = ">=1.1.0"
flake8 = ">=6.0.0"
build = "*"

[requires]
python_version = "3.10"
